  "resource_inventory_evidence_id": "ev_b7ec0f3b54328ce8e68e1eb5e8ee35e510ef9a4c80911504bb0b6e4e1c25338c",
  "facts": [
    {
      "sources": [
        "0x4153c0",
        "0x4015a0",
        "0x4231e0",
        "0x424d50",
        "0x424f00"
      ],
      "text": "License section is Game + original Games.Game Code text at S+1b80 + _License; key is MD5 of exact username bytes using current string data length. Default read0; force byteS+1bf6 must be zero and value exactly5 to skip modal. Explicit modal result1 clears force byte and calls write helper with5; write result is not checked."
    },
    {
      "sources": [
        "0x423c50",
        "0x423300",
        "0x423f40",
        "0x423d70",
        "0x423280",
        "0x423cc0",
        "0x4240a0",
        "0x424130",
        "0x424190",
        "0x4241f0",
        "0x424100"
      ],
      "text": "MD5 IV,64 constant/word/rotation/register schedules and four Boolean round helpers match RFC1321; update count is in bits;0x80 padding followed by LE bit length and LE digest bytes; formats at4b6e50 are00,0%x,%x."
    },
    {
      "sources": [
        "0x40bd50",
        "0x40c910",
        "0x40d370"
      ],
      "text": "Ghidra names40bd50 GetAllocLength, but it reads(data-0x10)+4. PrepareWrite2 compares current minimum at+4 against capacity at+8. Together with CStringData documentation, current data length is supported; do not hash allocated capacity."
    },
    {
      "sources": [
        "0x40f1c0",
        "0x40f6b0",
        "0x40f4f0",
        "0x40f530",
        "0x40f5c0"
      ],
      "text": "15 gameCode-1 rows of four resource IDs; six configured rows including Code11=[335,329,331,332]. Eligibility tests first two ID product, not actual resource load. Initial page0; three advances reach page3; a subsequent button action calls modal OK virtual slot. Negative decision has no observed version write."
    },
    {
      "sources": [
        "0x40fc90",
        "0x410250",
        "0x412b10",
        "0x42fc24"
      ],
      "text": "Username/password buffers start empty. Checkbox IDs3fe/3ff bindU+14e8/U+1644. Re-entry412b10 clears EditU+74(username) if14e8==0 and EditU+dc(password) if1644==0 via42fc24 SetWindowTextA with empty literals. This is UI/in-session retention, not proof of persistent storage."
    },
    {
      "sources": [
        "0x4015a0",
        "0x415d20"
      ],
      "text": "UserMode read default-1;1/2 retained, other values show mode dialog and write1 for result1,else2 to prefix+Settings/UserMode. Initialization mode1 shows password-retention control,sets username flag1/password0; mode2 hides password flag control/sets password0 but does not itself clear username flag. Later mode change clears both text fields; mode1 sets username1/password0,mode2 sets both0. Switching from2 to1 can be declined by a separate confirmation."
    }
  ],
  "independent_policies": [
    "Only game Code text1..15 and UI username1..16 non-NUL explicit bytes supported; no implicit Windows codepage, case/space conversion or general MD5 API.",
    "All four explicit pageAvailability booleans must be true before new review; unavailable page blocks review rather than reproducing native unchecked resource-copy failure.",
    "Review emits a local write intent only after explicit final decision at page3. No storage write, legal acceptance action or login authorisation is performed.",
    "Input reset returns owned bytes and explicit boolean checkbox snapshots; no disk remember mechanism or UserMode UI is implemented."
  ],
  "unknowns": [
    "Actual current Windows codepage and input notifications; runtime modal dispatch/presentation and real user decision.",
    "INI case/mapping/write durability, selected-game force reset lifecycle and real remembered account persistence beyond checked paths.",
    "Resource text/version freshness, trusted provenance and legal applicability; metadata hashes alone do not answer them.",
    "Trusted update/transform/rollback, full service session/opaque lifetime, actual platform transport and game consumer compatibility."
  ]
