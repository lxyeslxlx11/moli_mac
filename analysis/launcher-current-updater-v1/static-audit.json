    {
      "classification": "fact",
      "source": "0x40dd30",
      "statement": "Parsed argv count6 including executable: PID,URL,launcherPath,archiveSize,launcherMD5. Nonzero decimal uint32 PID; archive size1..256MiB; URL length1..2048, path1..259 UTF16 code units; MD5 normalized/32hex."
    },
    {
      "classification": "fact",
      "source": "0x403830 / 0x403cf0",
      "statement": "Parent image identity, absolute drive target, same directory as updater, non-reparse regular target/directory, and self-replacement checks are present. No host/guest runtime identity test performed."
    },
    {
      "classification": "fact",
      "source": "0x4071c0 / 0x406920",
      "statement": "Main transaction mutex, parent handoff event derived with parent creation time, parent wait60000ms, and marked-child ACK wait30000ms are present. Missing handoff event ERROR_FILE_NOT_FOUND permits legacy path; this is not an instruction to forge events."
    },
    {
