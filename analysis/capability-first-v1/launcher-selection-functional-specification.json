    {
      "id": "SP-F01",
      "classification": "事实",
      "claim": "L02原区域/行选择、排序、关联列、状态/期限限制、刷新候选五组及601b/C82/C7三来源保持；C7不是C82的同版替身。原两owner、L01依赖、D1批次和登记不变。",
      "source_refs": [
        {
          "document": "original_scope",
          "pointer": "/original_capability_reviews/1"
        }
      ]
    },
    {
      "id": "SP-F02",
      "classification": "事实",
      "claim": "三个来源的原区域/行选择直接复用既有合同：display位置、raw row ordinal、名称首匹配和Code是不同值。旧版及C7以源名称首匹配发布上下文，不能用目标唯一ID政策替代；C82预设的唯一性是另一入口的明确门槛。",
      "source_refs": [
