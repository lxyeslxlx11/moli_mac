  "facts": [
    {
      "type": "fact",
      "locations": [
        "0x409060..0x4090cd",
        "0x437670..0x4376e7",
        "0x436490..0x4364f6"
      ],
      "claim": "After document error flags, exact case-sensitive named direct-element search requires Gamelist/Games and Regionlist/Regions. This gate does not require Game/Region entries or validate business fields; empty containers can pass. First matching direct element is used."
    },
    {
      "type": "fact",
      "locations": [
        "0x4067c0..0x4069a3",
        "0x40695d",
        "0x406994"
      ],
      "claim": "File comparison opens both for read, checks 64bit lengths then repeated4096byte reads and byte equality. EAX=0 only on identical successful reads/EOF; unavailable/read/length/content failure yields1. Decompiler void is not its ABI."
    },
    {
      "type": "fact",
      "locations": [
        "retained0x40a1d0",
        "0x40d5e0..0x40d8c6"
      ],
      "claim": "Callback validates staged XML pair first, compares both full files, skips pair publication if both identical, otherwise invokes pair commit. Commit backs up existing originals, creates/flushed pending marker only when both originals existed, then replaces GameList before RegionList with MoveFileExA flags9; failure attempts restore/delete. Cleanup return values and partial rollback remain explicit; not atomic pair proof."
    },
    {
      "type": "fact",
      "locations": [
        "0x40bba0..0x40bdf3",
        "0x407ca0..0x40841d"
      ],
      "claim": "Normal catalog entry invokes recovery before loading. Missing marker yields recovery success without verifying catalogs in that helper. With marker it requires both backups, copies both over originals, reloads/rechecks containers, then deletes backups/marker. Failures can retain recovery state."
    },
    {
      "type": "fact",
      "locations": [
        "0x40fa80..0x40fcd7"
      ],
      "claim": "Previously unnamed helper is staged-file writing/path/attribute validation, not a digest validator. No catalog-digest compatibility claim is based on that function."
    }
  ],
