page { background: #101c26; color: #e9f1f6; font-family: -apple-system, sans-serif; }
.game-page { padding: 30rpx 24rpx 60rpx; }
.title { font-size: 48rpx; font-weight: 650; margin-bottom: 16rpx; }
.status, .hint, .line { font-size: 27rpx; line-height: 1.6; overflow-wrap: anywhere; }
.status { margin-bottom: 22rpx; }
.hint { color: #a7bdce; }
.card { border: 1px solid #3c5164; background: #182938; border-radius: 14rpx; padding: 20rpx; margin: 20rpx 0; }
.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.screen-wrap { margin: 18rpx 0; }
.screen { display: block; width: 100%; height: 526rpx; background: #0b141d; }
.controls { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin-top: 14rpx; }
.controls button { margin: 0; min-height: 72rpx; }
.character { border-bottom: 1px solid #3c5164; padding: 14rpx 0; }
.creation-group { margin-top: 20rpx; }
.creation-row { display: flex; gap: 12rpx; align-items: center; margin-top: 10rpx; font-size: 27rpx; }
.creation-row text:first-child { min-width: 108rpx; }
.creation-row button { margin: 0; min-width: 70rpx; min-height: 64rpx; }
.commerce-section { border-top: 1px solid #3c5164; padding-top: 16rpx; margin-top: 16rpx; }
.commerce-text { white-space: pre-wrap; }
.commerce-amount { width: 156rpx; }
.service-option { margin-top: 12rpx; }
.service-option button { margin-left: 0; min-height: 72rpx; white-space: normal; }
.storage-choice { margin-top: 14rpx; }
.family-list { max-height: 360rpx; margin-top: 12rpx; }
.board-draft { box-sizing: border-box; width: 100%; min-height: 140rpx; }
.dialog-art { display: block; width: 100%; margin-bottom: 12rpx; }
.inventory-slots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin: 12rpx 0; }
.inventory-slot { width: 100%; margin: 0; line-height: 1.4; min-height: 76rpx; white-space: normal; }
.inventory-selected { outline: 2px solid #4dbbc6; }
.inventory-target { outline: 2px solid #e0ad59; }
.chat-history { max-height: 250rpx; }
.field, .choice { background: #263c4e; border-radius: 10rpx; padding: 16rpx; font-size: 28rpx; }
.field { margin: 14rpx 0; }

.craft-panel { margin: 24rpx 0; padding: 24rpx; border: 2rpx solid #637d8d; border-radius: 16rpx; background: #17232d; color: #e2edf4; }
.craft-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin: 16rpx 0; }
.craft-grid button { width: 100%; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
.craft-position { padding: 12rpx; border: 2rpx solid #506575; border-radius: 8rpx; }
.craft-position.selected { border-color: #8ec9e5; }
.craft-panel .line { display: block; margin: 12rpx 0; overflow-wrap: anywhere; }

.craft-panel input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 16rpx; border: 2rpx solid #637d8d; color: #e2edf4; background: #17232d; }
