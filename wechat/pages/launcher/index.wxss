page { background: #f6f7f9; color: #172331; font-family: -apple-system, sans-serif; }
.page { padding: 42rpx 32rpx 64rpx; max-width: 900rpx; margin: 0 auto; }
.eyebrow { font-size: 23rpx; letter-spacing: 5rpx; color: #607086; }
.title { font-size: 50rpx; font-weight: 650; margin: 12rpx 0 24rpx; }
.status { font-size: 28rpx; line-height: 1.6; margin-bottom: 28rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 29rpx; font-weight: 600; margin-bottom: 20rpx; }
.choice, .field { background: #f3f5f8; border-radius: 12rpx; padding: 22rpx; margin: 14rpx 0; font-size: 29rpx; }
.field { height: 44rpx; }
.hint, .footer { color: #627086; font-size: 24rpx; line-height: 1.7; }
.hint { margin: 16rpx 0; }
.footer { margin: 30rpx 8rpx; }
button { margin-top: 18rpx; font-size: 28rpx; border-radius: 12rpx; }
button[type=primary] { background: #285780; }
button[type=primary][disabled] { background: #d7e0e9; color: #738095; }
.review-text { height: 480rpx; font-size: 28rpx; line-height: 1.8; white-space: pre-wrap; }
.profile { text-align: left; }
